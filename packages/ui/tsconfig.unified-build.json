{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noCheck": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "rootDir": "src",
    "outDir": "types"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.vue"],
  "exclude": ["src/components/*", "node_modules", "**/__tests__/**", "**/__demos__/**"]
}
