{
  "name": "@cedar-design/ui-vue",
  "version": "1.4.8",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sparknest-team/cedar-design-web.git",
    "directory": "packages/ui"
  },
  "sideEffects": [
    "src/**/style/*",
    "es/**/style/*",
    "lib/**/style/*",
    "*.css",
    "*.less"
  ],
  "exports": {
    "./trigger/server": {
      "browser": "./trigger-server-browser.mjs",
      "default": "./trigger-server.cjs"
    },
    ".": {
      "types": "./types/index.d.ts",
      "import": "./es/index.mjs",
      "require": "./lib/index.js"
    },
    "./style": {
      "types": "./reset/index.d.ts",
      "default": "./es/cedar.css"
    },
    "./package.json": "./package.json",
    "./*/style": {
      "import": "./es/*/style/index.mjs",
      "require": "./lib/*/style/index.js"
    },
    "./*": {
      "types": "./types/*/index.d.ts",
      "import": "./es/*/index.mjs",
      "require": "./lib/*/index.js"
    },
    "./scheduler/core": {
      "types": "./types/scheduler/core/index.d.ts",
      "import": "./es/scheduler/core/index.mjs",
      "require": "./lib/scheduler/core/index.js"
    },
    "./reset.css": {
      "types": "./reset/index.d.ts",
      "default": "./reset/index.css"
    },
    "./table/core": {
      "types": "./types/table/core/index.d.ts",
      "import": "./es/table/core/index.mjs",
      "require": "./lib/table/core/index.js"
    },
    "./table/features/filter": {
      "types": "./types/table/features/filter/index.d.ts",
      "import": "./es/table/features/filter/index.mjs",
      "require": "./lib/table/features/filter/index.js"
    },
    "./table/features/filter/client": {
      "types": "./types/table/features/filter/client/index.d.ts",
      "import": "./es/table/features/filter/client/index.mjs",
      "require": "./lib/table/features/filter/client/index.js"
    },
    "./table/features/sort": {
      "types": "./types/table/features/sort/index.d.ts",
      "import": "./es/table/features/sort/index.mjs",
      "require": "./lib/table/features/sort/index.js"
    },
    "./table/features/sort/client": {
      "types": "./types/table/features/sort/client/index.d.ts",
      "import": "./es/table/features/sort/client/index.mjs",
      "require": "./lib/table/features/sort/client/index.js"
    },
    "./table/core/style": {
      "types": "./reset/index.d.ts",
      "import": "./es/table/core/style/index.mjs",
      "require": "./lib/table/core/style/index.js"
    }
  },
  "main": "lib/index.js",
  "jsdelivr": "umd/cedar.js",
  "unpkg": "umd/cedar.js",
  "module": "es/index.mjs",
  "types": "types/index.d.ts",
  "style": "es/cedar.css",
  "files": [
    "trigger-server.cjs",
    "trigger-server.mjs",
    "trigger-server-browser.mjs",
    "es",
    "lib",
    "types",
    "umd",
    "reset"
  ],
  "scripts": {
    "build": "pnpm build:lib && pnpm build:doc",
    "build:doc": "node --max-old-space-size=6144 ./node_modules/vuepress/bin/vuepress.js build docs --dest dist",
    "build:lib": "cedar-cli compile ui-build.config.mjs",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -r 2",
    "clean-cache": "rm -rf docs/.vuepress/.cache docs/.vuepress/.cache-build docs/.vuepress/.temp docs/.vuepress/.temp-build node_modules/.vite",
    "coverage": "vitest run --coverage",
    "dev": "vuepress dev docs",
    "docs:llms": "ui-docs-llms cedar . docs/.vuepress/public",
    "dtsgen": "tsx scripts dtsgen 'components/**/*.{ts,tsx,vue}'",
    "format": "prettier --write .",
    "lint": "eslint src --max-warnings 0 && node ../../../design-ui/bin/api-naming-check.mjs",
    "lint-staged": "lint-staged",
    "prepublishOnly": "pnpm build:lib",
    "preview": "vite preview --config docs/.vuepress/preview.config.ts",
    "test": "vitest run && vitest run --config docs/.vuepress/vitest.config.mts",
    "test:watch": "vitest",
    "typecheck": "tsc --runExternalCode -p tsconfig.release-check.json",
    "typecheck:contracts": "tsc -p tsconfig.contracts.json",
    "ui:gen": "tsx scripts/generate/component.ts",
    "watch": "vite build --watch"
  },
  "lint-staged": {
    "src/**/*.{js,ts,tsx,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/**/*.{json,css,less,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@cedar-design/icons-vue": "workspace:*",
    "@cedar-design/shared-vue": "workspace:*",
    "@cedar-design/use-vue": "workspace:*",
    "@js-temporal/polyfill": "^0.5.1",
    "b-tween": "^0.3.3",
    "b-validate": "^1.5.3",
    "compute-scroll-into-view": "^3.2.2",
    "csstype": "^3.2.4",
    "dayjs": "^1.11.23",
    "decimal.js": "^10.6.0",
    "kotlin-playground": "^1.34.0",
    "lodash": "^4.18.1",
    "lodash-es": "^4.18.1",
    "number-precision": "^1.6.0",
    "parse5": "^8.1.1",
    "resize-observer-polyfill": "^1.5.1",
    "rrule": "^2.8.1",
    "scroll-into-view-if-needed": "^3.2.1",
    "sortablejs": "^1.15.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cedar-design/cli-vue": "workspace:*",
    "@cedar-design/resolver-vue": "workspace:*",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@mdit-vue/shared": "^4.0.0",
    "@sparknest/ui-doc-preview-vue": "^1.4.4",
    "@sparknest/vuepress-plugins-vue": "^1.0.0",
    "@types/fs-extra": "^11.0.4",
    "@types/lodash-es": "^4.17.12",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.11",
    "@types/prompts": "^2.4.9",
    "@typescript-eslint/eslint-plugin": "^8.74.0",
    "@typescript-eslint/parser": "^8.74.0",
    "@vitejs/plugin-vue": "6.0.11",
    "@vitejs/plugin-vue-jsx": "5.1.6",
    "@vitest/coverage-v8": "5.1.2",
    "@vitest/ui": "5.1.2",
    "@vue/content-mapper": "4.0.0-alpha.0",
    "@vue/repl": "^4.7.2",
    "@vue/runtime-core": "catalog:",
    "@vue/server-renderer": "catalog:",
    "@vue/test-utils": "^2.6.0",
    "@vuepress/bundler-vite": "2.0.0-rc.32",
    "@vuepress/helper": "2.0.0-rc.139",
    "@vuepress/plugin-copy-code": "2.0.0-rc.139",
    "@vuepress/plugin-medium-zoom": "^2.0.0-rc.139",
    "@vuepress/plugin-prismjs": "2.0.0-rc.139",
    "@vuepress/plugin-shiki": "2.0.0-rc.139",
    "@vuepress/plugin-slimsearch": "2.0.0-rc.139",
    "@vuepress/theme-default": "^2.0.0-rc.139",
    "@vueuse/core": "^15.1.0",
    "axe-core": "^4.14.1",
    "color": "^5.0.3",
    "commitizen": "^4.3.2",
    "components-helper": "^2.2.0",
    "conventional-changelog": "^8.1.3",
    "conventional-changelog-angular": "^9.4.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "execa": "^10.2.1",
    "fast-glob": "^3.3.3",
    "fs-extra": "^11.4.1",
    "globby": "^16.2.4",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "less": "^4.9.1",
    "lint-staged": "^17.6.2",
    "loca-boot-core": "^1.73.21",
    "markdown-it": "^15.0.3",
    "ora": "^10.0.0",
    "postcss": "^8.5.33",
    "posthtml-parser": "^0.13.0",
    "posthtml-render": "^3.0.0",
    "prettier": "^3.10.1",
    "prismjs": "1.30.0",
    "prompts": "^2.4.2",
    "sandpack-vue3": "^3.1.12",
    "sass": "^1.108.2",
    "sass-embedded": "^1.108.2",
    "stylelint": "^18.1.0",
    "svgo": "^4.1.0",
    "ts-morph": "^28.0.0",
    "tsx": "^4.23.15",
    "typescript": "7.1.0-beta",
    "typescript-js": "npm:typescript@6.0.3",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "8.3.8",
    "vitest": "5.1.2",
    "vue": "catalog:",
    "vue-eslint-parser": "^10.4.2",
    "vue-router": "5.5.1",
    "vuepress": "2.0.0-rc.32",
    "vuepress-plugin-md-enhance": "2.0.0-rc.111",
    "vuepress-theme-hope": "2.0.0-rc.111"
  },
  "peerDependencies": {
    "vue": "3"
  },
  "packageManager": "pnpm@10.23.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
