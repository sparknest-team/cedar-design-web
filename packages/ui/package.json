{
  "name": "@cedar-design/ui-vue",
  "version": "1.4.6",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sparknest-team/cedar-design-web.git",
    "directory": "packages/ui"
  },
  "sideEffects": [
    "src/**/style/*",
    "es/**/style/*",
    "lib/**/style/*",
    "*.css",
    "*.less"
  ],
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./es/index.mjs",
      "require": "./lib/index.js"
    },
    "./style": {
      "types": "./reset/index.d.ts",
      "default": "./es/cedar.css"
    },
    "./package.json": "./package.json",
    "./*/style": {
      "import": "./es/*/style/index.mjs",
      "require": "./lib/*/style/index.js"
    },
    "./*": {
      "types": "./types/*/index.d.ts",
      "import": "./es/*/index.mjs",
      "require": "./lib/*/index.js"
    },
    "./scheduler/core": {
      "types": "./types/scheduler/core/index.d.ts",
      "import": "./es/scheduler/core/index.mjs",
      "require": "./lib/scheduler/core/index.js"
    },
    "./reset.css": {
      "types": "./reset/index.d.ts",
      "default": "./reset/index.css"
    },
    "./table/core": {
      "types": "./types/table/core/index.d.ts",
      "import": "./es/table/core/index.mjs",
      "require": "./lib/table/core/index.js"
    },
    "./table/features/filter": {
      "types": "./types/table/features/filter/index.d.ts",
      "import": "./es/table/features/filter/index.mjs",
      "require": "./lib/table/features/filter/index.js"
    },
    "./table/features/filter/client": {
      "types": "./types/table/features/filter/client/index.d.ts",
      "import": "./es/table/features/filter/client/index.mjs",
      "require": "./lib/table/features/filter/client/index.js"
    },
    "./table/features/sort": {
      "types": "./types/table/features/sort/index.d.ts",
      "import": "./es/table/features/sort/index.mjs",
      "require": "./lib/table/features/sort/index.js"
    },
    "./table/features/sort/client": {
      "types": "./types/table/features/sort/client/index.d.ts",
      "import": "./es/table/features/sort/client/index.mjs",
      "require": "./lib/table/features/sort/client/index.js"
    },
    "./table/core/style": {
      "types": "./reset/index.d.ts",
      "import": "./es/table/core/style/index.mjs",
      "require": "./lib/table/core/style/index.js"
    }
  },
  "main": "lib/index.js",
  "jsdelivr": "umd/cedar.js",
  "unpkg": "umd/cedar.js",
  "module": "es/index.mjs",
  "types": "types/index.d.ts",
  "style": "es/cedar.css",
  "files": [
    "es",
    "lib",
    "types",
    "umd",
    "reset"
  ],
  "scripts": {
    "build": "pnpm build:lib && pnpm build:doc",
    "build:doc": "pnpm docs:llms && node --max-old-space-size=6144 ./node_modules/vuepress/bin/vuepress.js build docs --dest dist",
    "build:lib": "cedar-cli compile ui-build.config.mjs",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s -r 2",
    "clean-cache": "rm -rf docs/.vuepress/.cache docs/.vuepress/.cache-build docs/.vuepress/.temp docs/.vuepress/.temp-build node_modules/.vite",
    "coverage": "vitest run --coverage",
    "dev": "vuepress dev docs",
    "docs:llms": "node ../../../design-ui/bin/llms-docs.mjs cedar . docs/.vuepress/public",
    "dtsgen": "tsx scripts dtsgen 'components/**/*.{ts,tsx,vue}'",
    "format": "prettier --write .",
    "lint": "eslint src --max-warnings 0 && node ../../../design-ui/bin/api-naming-check.mjs",
    "lint-staged": "lint-staged",
    "prepublishOnly": "pnpm build:lib",
    "preview": "vite preview --config docs/.vuepress/preview.config.ts",
    "test": "vitest run && vitest run --config docs/.vuepress/vitest.config.mts",
    "test:watch": "vitest",
    "typecheck": "vue-tsc -p tsconfig.declaration.json --noEmit",
    "typecheck:contracts": "tsc -p tsconfig.contracts.json",
    "ui:gen": "tsx scripts/generate/component.ts",
    "watch": "vite build --watch"
  },
  "lint-staged": {
    "src/**/*.{js,ts,tsx,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/**/*.{json,css,less,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@cedar-design/icons-vue": "workspace:*",
    "@cedar-design/shared-vue": "workspace:*",
    "@cedar-design/use-vue": "workspace:*",
    "@js-temporal/polyfill": "^0.5.1",
    "b-tween": "^0.3.3",
    "b-validate": "^1.5.3",
    "compute-scroll-into-view": "^3.1.1",
    "csstype": "^3.2.3",
    "dayjs": "^1.10.3",
    "decimal.js": "^10.6.0",
    "kotlin-playground": "^1.30.0",
    "lodash": "^4.17.21",
    "lodash-es": "^4.17.21",
    "number-precision": "^1.6.0",
    "resize-observer-polyfill": "^1.5.1",
    "rrule": "^2.8.1",
    "scroll-into-view-if-needed": "^3.1.0",
    "sortablejs": "^1.15.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@cedar-design/cli-vue": "workspace:*",
    "@cedar-design/resolver-vue": "workspace:*",
    "@changesets/changelog-github": "^0.4.8",
    "@changesets/cli": "^2.26.1",
    "@commitlint/cli": "^17.5.1",
    "@commitlint/config-conventional": "^17.4.4",
    "@mdit-vue/shared": "^0.7.0",
    "@types/fs-extra": "^9.0.13",
    "@types/lodash-es": "^4.17.6",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.0.0",
    "@types/prompts": "^2.0.14",
    "@typescript-eslint/eslint-plugin": "^8.12.2",
    "@typescript-eslint/parser": "^8.12.2",
    "@vitejs/plugin-vue": "6.0.11",
    "@vitejs/plugin-vue-jsx": "5.1.6",
    "@vitest/coverage-v8": "5.1.0",
    "@vitest/ui": "5.1.0",
    "@vue/repl": "^4.4.2",
    "@vue/runtime-core": "catalog:",
    "@vue/server-renderer": "catalog:",
    "@vue/test-utils": "^2.0.2",
    "@vuepress/bundler-vite": "2.0.0-rc.18",
    "@vuepress/helper": "2.0.0-rc.63",
    "@vuepress/plugin-copy-code": "2.0.0-rc.63",
    "@vuepress/plugin-medium-zoom": "2.0.0-rc.63",
    "@vuepress/plugin-prismjs": "2.0.0-rc.61",
    "@vuepress/plugin-shiki": "2.0.0-rc.63",
    "@vuepress/plugin-slimsearch": "2.0.0-rc.63",
    "@vuepress/theme-default": "^2.0.0-rc.26",
    "@vueuse/core": "^12.8.2",
    "axe-core": "^4.10.3",
    "color": "^4.2.3",
    "commitizen": "^4.3.0",
    "components-helper": "^2.0.0",
    "conventional-changelog-cli": "^4.1.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.12.1",
    "execa": "^6.1.0",
    "fast-glob": "^3.2.11",
    "fs-extra": "^11.2.0",
    "globby": "^14.0.1",
    "happy-dom": "^6.0.4",
    "husky": "^8.0.3",
    "jsdom": "^24.0.0",
    "less": "^4.4.0",
    "lint-staged": "^13.2.0",
    "loca-boot-core": "^1.73.7",
    "markdown-it": "^14.1.0",
    "ora": "^8.0.1",
    "postcss": "^8.4.21",
    "posthtml-parser": "^0.11.0",
    "posthtml-render": "^3.0.0",
    "prettier": "^3.3.3",
    "prismjs": "1.30.0",
    "prompts": "^2.4.2",
    "sandpack-vue3": "^3.1.12",
    "sass": "^1.80.3",
    "sass-embedded": "^1.79.5",
    "stylelint": "^14.16.1",
    "svgo": "^3.3.2",
    "ts-morph": "^22.0.0",
    "tsx": "^3.8.2",
    "typescript": "~5.6.3",
    "unplugin-auto-import": "^20.3.0",
    "unplugin-vue-components": "^0.22.4",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "vue": "catalog:",
    "vue-eslint-parser": "^10.4.2",
    "vue-router": "^4.2.5",
    "vue-tsc": "^2.1.10",
    "vuepress": "2.0.0-rc.18",
    "vuepress-plugin-md-enhance": "^2.0.0-rc.43",
    "vuepress-theme-hope": "2.0.0-rc.61"
  },
  "peerDependencies": {
    "vue": "3"
  },
  "packageManager": "pnpm@10.23.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
