      "defaultValue": "undefined",
      "description": "后代默认尺寸；省略继承父配置，组件自己的 size 优先",
      "kind": "enum",
      "options": [
        "xs",
        "sm",
        "md",
        "lg",
        "xl"
      ],
      "initial": "xs"
    },
    {
      "name": "global",
      "type": "boolean",
      "defaultValue": "false",
      "description": "setup 时选择应用级注入；不是动态开关，需用于与应用同寿命的根配置",
      "kind": "boolean"
    },
    {
      "name": "update-at-scroll",
      "type": "boolean",
      "defaultValue": "undefined",
      "description": "省略继承父配置，根回退 false；仅由支持该配置的弹层消费",
      "kind": "boolean"
    },
    {
      "name": "scroll-to-close",
      "type": "boolean",
      "defaultValue": "undefined",
      "description": "省略继承父配置，根回退 false；不会主动关闭所有弹层",
      "kind": "boolean"
    },
    {
      "name": "dir",
      "type": "\"ltr\" | \"rtl\"",
      "defaultValue": "undefined",
      "description": "阅读方向；省略时继承来源作用域。物理 left/right 方位保持原意。",
      "kind": "enum",
      "options": [
        "ltr",
        "rtl"
      ]
    }
