{
  "fields": [
    {
      "name": "open",
      "description": "受控打开状态",
      "type": "boolean",
      "defaultValue": "undefined",
      "kind": "boolean"
    },
    {
      "name": "default-open",
      "description": "非受控初始状态",
      "type": "boolean",
      "defaultValue": "false",
      "kind": "boolean"
    },
    {
      "name": "trigger",
      "description": "触发方式，可组合",
      "type": "hover | click | focus | contextMenu | manual | TriggerEvent[]",
      "defaultValue": "'hover'",
      "kind": "json",
      "initial": "[]"
    },
    {
      "name": "disabled",
      "description": "禁止打开",
      "type": "boolean",
      "defaultValue": "false",
      "kind": "boolean"
    },
    {
      "name": "reference",
      "description": "外部参考元素；不传时使用默认插槽首个真实元素",
      "type": "string | HTMLElement | SVGElement",
      "defaultValue": "undefined",
      "kind": "string",
      "initial": "body"
    },
    {
      "name": "placement",
      "description": "首选方位，支持四个方向及 -start/-end",
      "type": "\"top\" | \"top-start\" | \"top-end\" | \"bottom\" | \"bottom-start\" | \"bottom-end\" | \"left\" | \"left-start\" | \"left-end\" | \"right\" | \"right-start\" | \"right-end\"",
      "defaultValue": "'bottom'",
      "kind": "enum",
      "options": [
        "top",
        "top-start",
        "top-end",
        "bottom",
        "bottom-start",
        "bottom-end",
        "left",
        "left-start",
        "left-end",
        "right",
        "right-start",
        "right-end"
      ],
      "initial": "bottom"
    },
    {
      "name": "strategy",
      "description": "定位策略",
      "type": "'absolute' | 'fixed'",
      "defaultValue": "'absolute'",
      "kind": "enum",
      "options": [
        "absolute",
        "fixed"
      ],
      "initial": "absolute"
    },
    {
      "name": "cover",
      "description": "沿主轴覆盖参考元素",
      "type": "boolean",
      "defaultValue": "false",
      "kind": "boolean"
    },
    {
      "name": "popup-offset",
      "description": "沿 placement 主轴向外的距离",
      "type": "number",
      "defaultValue": "0",
      "kind": "number"
    },
    {
      "name": "popup-translate",
      "description": "屏幕轴平移，或按 placement 配置平移",
      "type": "[number, number] | Partial<Record<TriggerPlacement, [number, number]>>",
      "defaultValue": "undefined",
      "kind": "json",
      "initial": "{}"
    },
    {
      "name": "align-point",
      "description": "以鼠标坐标作为虚拟参考点",
      "type": "boolean",
      "defaultValue": "false",
      "kind": "boolean"
    },
    {
      "name": "popup-container",
      "description": "挂载容器；false 表示原地渲染",
      "type": "string | HTMLElement | false",
      "defaultValue": "undefined",
      "kind": "json",
      "initial": "\"body\""
    },
    {
      "name": "auto-fit-position",
      "description": "空间不足时翻转并限制到可视区域",
      "type": "boolean",
      "defaultValue": "true",
      "kind": "boolean"
    },
    {
      "name": "auto-fit-popup-width",
      "description": "浮层宽度等于参考元素宽度",
      "type": "boolean",
      "defaultValue": "false",
      "kind": "boolean"
    },
    {
      "name": "auto-fit-popup-min-width",
      "description": "浮层最小宽度等于参考元素宽度",
      "type": "boolean",
      "defaultValue": "false",
      "kind": "boolean"
    },
    {
      "name": "auto-fix-position",
      "description": "尺寸变化时自动重新定位",
      "type": "boolean",
      "defaultValue": "true",
      "kind": "boolean"
    },
    {
      "name": "update-at-scroll",
      "description": "滚动时重新定位",
      "type": "boolean",
      "defaultValue": "false",
      "kind": "boolean"
    },
    {
      "name": "scroll-to-close",
      "description": "滚动超过阈值时关闭",
      "type": "boolean",
      "defaultValue": "false",
      "kind": "boolean"
    },
    {
      "name": "scroll-to-close-distance",
      "description": "滚动关闭阈值",
      "type": "number",
      "defaultValue": "0",
      "kind": "number"
    },
    {
      "name": "show-arrow",
      "description": "渲染装饰箭头",
      "type": "boolean",
      "defaultValue": "false",
      "kind": "boolean"
    },
    {
      "name": "hide-empty",
      "description": "content 为空时不渲染浮层",
      "type": "boolean",
      "defaultValue": "false",
      "kind": "boolean"
    },
    {
      "name": "prevent-focus",
      "description": "阻止定位层 mousedown 抢占焦点",
      "type": "boolean",
      "defaultValue": "false",
      "kind": "boolean"
    },
    {
      "name": "unmount-on-close",
      "description": "离场结束后卸载内容",
      "type": "boolean",
      "defaultValue": "true",
      "kind": "boolean"
    },
    {
      "name": "animation-name",
      "description": "Vue Transition 名称",
      "type": "string",
      "defaultValue": "'trigger-fade'",
      "kind": "string"
    },
    {
      "name": "duration",
      "description": "过渡时长",
      "type": "number | { enter: number; leave: number }",
      "defaultValue": "undefined",
      "kind": "json",
      "initial": "{}"
    },
    {
      "name": "auto-fit-transform-origin",
      "description": "根据最终方位设置动画原点",
      "type": "boolean",
      "defaultValue": "false",
      "kind": "boolean"
    },
    {
      "name": "opened-class",
      "description": "打开时附加给首个参考节点的类名",
      "type": "ClassName",
      "defaultValue": "undefined",
      "kind": "string",
      "initial": "review-class"
    },
    {
      "name": "focus-delay",
      "description": "focus 打开延迟，毫秒",
      "type": "number",
      "defaultValue": "0",
      "kind": "number"
    },
    {
      "name": "popup-hover-stay",
      "description": "指针进入浮层后保持打开",
      "type": "boolean",
      "defaultValue": "true",
      "kind": "boolean"
    },
    {
      "name": "blur-to-close",
      "description": "失焦时关闭",
      "type": "boolean",
      "defaultValue": "true",
      "kind": "boolean"
    },
    {
      "name": "close-on-click-reference",
      "description": "再次点击参考元素时关闭",
      "type": "boolean",
      "defaultValue": "true",
      "kind": "boolean"
    },
    {
      "name": "click-outside-to-close",
      "description": "点击外部关闭",
      "type": "boolean",
      "defaultValue": "true",
      "kind": "boolean"
    },
    {
      "name": "esc-to-close",
      "description": "Escape 关闭",
      "type": "boolean",
      "defaultValue": "true",
      "kind": "boolean"
    },
    {
      "name": "restore-focus",
      "description": "关闭被接受后恢复参考元素焦点",
      "type": "boolean",
      "defaultValue": "true",
      "kind": "boolean"
    },
    {
      "name": "mouse-enter-delay",
      "type": "number",
      "defaultValue": "100",
      "description": "源码公开属性 / Public source prop",
      "kind": "number"
    },
    {
      "name": "mouse-leave-delay",
      "type": "number",
      "defaultValue": "100",
      "description": "源码公开属性 / Public source prop",
      "kind": "number"
    },
    {
      "name": "popup-class",
      "type": "[String, Array, Object]",
      "defaultValue": "undefined",
      "description": "源码公开属性 / Public source prop",
      "kind": "string",
      "initial": "review-class"
    },
    {
      "name": "popup-style",
      "type": "CSSProperties",
      "defaultValue": "undefined",
      "description": "源码公开属性 / Public source prop",
      "kind": "json",
      "initial": "{}"
    },
    {
      "name": "content-class",
      "type": "[String, Array, Object]",
      "defaultValue": "undefined",
      "description": "源码公开属性 / Public source prop",
      "kind": "string",
      "initial": "review-class"
    },
    {
      "name": "content-style",
      "type": "CSSProperties",
      "defaultValue": "undefined",
      "description": "源码公开属性 / Public source prop",
      "kind": "json",
      "initial": "{}"
    },
    {
      "name": "arrow-class",
      "type": "[String, Array, Object]",
      "defaultValue": "undefined",
      "description": "源码公开属性 / Public source prop",
      "kind": "string",
      "initial": "review-class"
    },
    {
      "name": "arrow-style",
      "type": "CSSProperties",
      "defaultValue": "undefined",
      "description": "源码公开属性 / Public source prop",
      "kind": "json",
      "initial": "{}"
    },
    {
      "name": "reference-attrs",
      "type": "TriggerReferenceAttrs | ((open: boolean) => TriggerReferenceAttrs)",
      "defaultValue": "undefined",
      "description": "写入实际触发元素的属性；函数参数为当前打开状态。",
      "kind": "callback"
    }
  ],
