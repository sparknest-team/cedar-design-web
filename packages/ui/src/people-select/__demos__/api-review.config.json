{
  "fields": [
    {
      "name": "options",
      "description": "外部人员候选数组",
      "type": "readonly PeopleSelectOption[]",
      "defaultValue": "[]",
      "kind": "json"
    },
    {
      "name": "loading",
      "description": "外部加载状态",
      "type": "boolean",
      "defaultValue": "false",
      "kind": "boolean"
    },
    {
      "name": "model-value",
      "description": "绑定值",
      "type": "string",
      "defaultValue": "''",
      "kind": "string"
    },
    {
      "name": "default-value",
      "description": "非受控初始值，仅创建时读取",
      "type": "string",
      "defaultValue": "undefined",
      "kind": "string"
    },
    {
      "name": "is-label",
      "description": "是否是阅读模式",
      "type": "boolean",
      "defaultValue": "false",
      "kind": "boolean"
    },
    {
      "name": "edit-mode",
      "type": "'direct' | 'click' | 'dblclick'",
      "defaultValue": "undefined",
      "description": "字段编辑方式，字段 > FormItem > Form 继承；默认 direct。",
      "kind": "enum",
      "options": [
        "direct",
        "click",
        "dblclick"
      ],
      "initial": "direct"
    },
    {
      "name": "read-pretty",
      "type": "boolean",
      "defaultValue": "undefined",
      "description": "纯阅读展示；字段 > FormItem > Form 继承，显式 false 覆盖父级。",
      "kind": "boolean"
    },
    {
      "name": "before-commit",
      "type": "BeforeFieldCommit",
      "defaultValue": "undefined",
      "description": "源码公开属性 / Public source prop",
      "kind": "callback"
    },
    {
      "name": "open",
      "type": "boolean",
      "defaultValue": "undefined",
      "description": "源码公开属性 / Public source prop",
      "kind": "boolean"
    },
    {
      "name": "default-open",
      "type": "boolean",
      "defaultValue": "false",
      "description": "源码公开属性 / Public source prop",
      "kind": "boolean"
    },
    {
      "name": "popup-container",
      "type": "string | HTMLElement | false",
      "defaultValue": "undefined",
      "description": "源码公开属性 / Public source prop",
      "kind": "json",
      "initial": "\"body\""
    },
    {
      "name": "name",
      "type": "string",
      "defaultValue": "undefined",
      "description": "源码公开属性 / Public source prop",
      "kind": "string"
    },
    {
      "name": "default-text",
      "type": "string",
      "defaultValue": "'-'",
      "description": "源码公开属性 / Public source prop",
      "kind": "string"
    },
    {
      "name": "clearable",
      "type": "boolean",
      "defaultValue": "false",
      "description": "源码公开属性 / Public source prop",
      "kind": "boolean"
    },
    {
      "name": "label",
      "type": "string",
      "defaultValue": "''",
      "description": "当前 ID 不在候选中时的反显文本",
      "kind": "string"
    },
    {
      "name": "placeholder",
      "type": "string",
      "defaultValue": "undefined",
      "description": "源码公开属性 / Public source prop",
      "kind": "string"
    },
    {
      "name": "case-sensitive",
      "description": "内置本地过滤是否区分大小写；自定义过滤函数优先",
      "type": "boolean",
      "defaultValue": "false",
      "kind": "boolean"
    },
    {
      "name": "search-fields",
      "type": "readonly ('label' | 'value')[]",
      "defaultValue": "['label']",
      "description": "内置匹配字段，多字段 OR；默认 label",
      "kind": "json",
      "initial": "[\"label\"]"
    }
  ],
  "events": [
    "change",
    "clear",
    "update:modelValue",
    "update:open",
    "search"
  ],
  "scenarios": [
    {
      "name": "before-commit",
      "kind": "prop",
      "demos": []
    },
    {
      "name": "default",
      "kind": "slot",
      "demos": []
    }
  ],
  "slotNames": [
    "default"
  ],
  "slotDefaults": {
    "default": false
  },
  "methodNames": []
}
