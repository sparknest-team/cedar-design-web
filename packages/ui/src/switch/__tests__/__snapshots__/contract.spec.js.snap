// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`renders the common contract 1`] = `"<button type=\\"button\\" role=\\"switch\\" class=\\"c-switch c-switch--variant-circle c-switch--size-md\\" aria-checked=\\"false\\"><span class=\\"c-switch__track\\" aria-hidden=\\"true\\"></span><span class=\\"c-switch__text\\"></span><span class=\\"c-switch__handle\\" style=\\"box-shadow: 0 1px 3px var(--c-switch-shadow-color);\\"><!--v-if--></span></button>"`;
