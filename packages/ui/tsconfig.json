{
  "contentMappers": [
    {
      "package": "@vue/content-mapper",
      "extensions": [".vue"],
      "options": { "dataAttributes": ["data-*"], "fallthroughAttributes": true }
    }
  ],
  "compilerOptions": {
    "sourceMap": true,
    "allowJs": true,
    "strictNullChecks": true,
    "target": "ESNext",
    "outDir": "dist",
    "declaration": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "allowSyntheticDefaultImports": true,
    "allowImportingTsExtensions": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "useDefineForClassFields": true,
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "strict": true,
    "noImplicitThis": true,
    "noImplicitAny": false,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["node", "vite/client"],
    "paths": {
      "@cedar-design/ui-vue/trigger/server": ["./src/trigger/server-module.d.ts"],
      "@cedar-design/ui-vue": ["./src/index.ts"],
      "vue": ["./node_modules/vue"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "*.config.mts",
    "docs/.vuepress/vitest.config.mts",
    "docs/**/*.ts",
    "docs/**/*.d.ts",
    "docs/.vuepress/auto-imports.d.ts"
  ]
}
