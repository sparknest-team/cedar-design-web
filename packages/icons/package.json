{
  "name": "@cedar-design/icons-vue",
  "version": "1.1.2",
  "description": "SVG icon components for Cedar",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.cjs",
  "module": "./es/index.mjs",
  "types": "./types/index.d.ts",
  "sideEffects": [
    "./style.css"
  ],
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./es/index.mjs",
      "require": "./lib/index.cjs"
    },
    "./*": {
      "types": "./types/*/index.d.ts",
      "import": "./es/*/index.mjs",
      "require": "./lib/*/index.cjs"
    },
    "./style.css": "./style.css"
  },
  "files": [
    "es",
    "lib",
    "types",
    "style.css"
  ],
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "generate:check": "node scripts/generate.mjs --check",
    "build": "pnpm generate:check && node scripts/build.mjs",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "vue": "^3.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.4",
    "svgo": "^3.3.2",
    "typescript": "catalog:",
    "vite": "^5.4.0",
    "vue": "catalog:",
    "vue-tsc": "^2.0.29"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
