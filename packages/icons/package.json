{
  "name": "@cedar-design/icons-vue",
  "version": "1.4.6",
  "description": "SVG icon components for Cedar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sparknest-team/cedar-design-web.git",
    "directory": "packages/icons"
  },
  "license": "MIT",
  "sideEffects": [
    "./style.css"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./types/index.d.ts",
        "default": "./es/index.mjs"
      },
      "require": {
        "types": "./types/index.d.cts",
        "default": "./lib/index.cjs"
      }
    },
    "./*": {
      "import": {
        "types": "./types/*/index.d.ts",
        "default": "./es/*/index.mjs"
      },
      "require": {
        "types": "./types/*/index.d.cts",
        "default": "./lib/*/index.cjs"
      }
    },
    "./style.css": "./style.css"
  },
  "main": "./lib/index.cjs",
  "module": "./es/index.mjs",
  "types": "./types/index.d.ts",
  "files": [
    "es",
    "lib",
    "types",
    "style.css"
  ],
  "scripts": {
    "build": "pnpm generate:check && node scripts/build.mjs",
    "generate": "node scripts/generate.mjs",
    "generate:check": "node scripts/generate.mjs --check",
    "typecheck": "vue-tsc --noEmit -p tsconfig.contract.json"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.11",
    "svgo": "^3.3.2",
    "typescript": "catalog:",
    "vite": "8.3.8",
    "vue": "catalog:",
    "vue-tsc": "^2.0.29"
  },
  "peerDependencies": {
    "vue": "^3.2.47"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
