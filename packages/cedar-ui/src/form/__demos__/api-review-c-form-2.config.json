{
  "fields": [
    {
      "name": "model",
      "description": "表单数据对象",
      "type": "object",
      "defaultValue": "() => ({})",
      "kind": "json",
      "initial": "{}"
    },
    {
      "name": "layout",
      "description": "表单的布局方式，包括水平、垂直、多列",
      "type": "'horizontal' | 'vertical' | 'inline'",
      "defaultValue": "'horizontal'",
      "kind": "enum",
      "options": [
        "horizontal",
        "vertical",
        "inline"
      ],
      "initial": "horizontal"
    },
    {
      "name": "size",
      "description": "表单控件的尺寸",
      "type": "\"xs\" | \"sm\" | \"md\" | \"lg\" | \"xl\"",
      "defaultValue": "undefined",
      "kind": "enum",
      "options": [
        "xs",
        "sm",
        "md",
        "lg",
        "xl"
      ],
      "initial": "xs"
    },
    {
      "name": "label-col-flex",
      "description": "标签列 flex；数字为伸缩比例，带单位字符串为宽度",
      "type": "number | string",
      "defaultValue": "undefined",
      "kind": "scalar"
    },
    {
      "name": "label-col-style",
      "description": "标签列逐实例样式",
      "type": "CSSProperties",
      "defaultValue": "undefined",
      "kind": "json",
      "initial": "{}"
    },
    {
      "name": "wrapper-col-style",
      "description": "内容列逐实例样式",
      "type": "CSSProperties",
      "defaultValue": "undefined",
      "kind": "json",
      "initial": "{}"
    },
    {
      "name": "label-col-props",
      "description": "标签元素布局选项。参数同 <col> 组件一致",
      "type": "object",
      "defaultValue": "() => ({ span: 5, offset: 0 })",
      "kind": "json",
      "initial": "{}"
    },
    {
      "name": "wrapper-col-props",
      "description": "表单控件布局选项。参数同 <col> 组件一致",
      "type": "object",
      "defaultValue": "() => ({ span: 19, offset: 0 })",
      "kind": "json",
      "initial": "{}"
    },
    {
      "name": "label-align",
      "description": "标签的对齐方向",
      "type": "'left' | 'right'",
      "defaultValue": "'right'",
      "kind": "enum",
      "options": [
        "left",
        "right"
      ],
      "initial": "right"
    },
    {
      "name": "disabled",
      "description": "是否禁用表单",
      "type": "boolean",
      "defaultValue": "undefined",
      "kind": "boolean"
    },
    {
      "name": "readonly",
      "description": "是否将表单控件设为只读",
      "type": "boolean",
      "defaultValue": "undefined",
      "kind": "boolean"
    },
    {
      "name": "rules",
      "description": "表单项校验规则",
      "type": "Record<string, FieldRule | FieldRule[]>",
      "defaultValue": "undefined",
      "kind": "json",
      "initial": "{}"
    },
    {
      "name": "auto-label-width",
      "description": "是否开启自动标签宽度，仅在 layout=\"horizontal\" 下生效。",
      "type": "boolean",
      "defaultValue": "false",
      "kind": "boolean"
    },
    {
      "name": "id",
      "description": "表单控件id的前缀",
      "type": "string",
      "defaultValue": "undefined",
      "kind": "string"
    },
    {
      "name": "scroll-to-error",
      "description": "验证失败后滚动到页面顺序的第一个（start）或最后一个（end）错误字段；不是视口对齐方式",
      "type": "'start' | 'end'",
      "defaultValue": "undefined",
      "kind": "enum",
      "options": [
        "start",
        "end"
      ],
      "initial": "start"
    },
    {
      "name": "presentation",
      "type": "'inline' | 'click' | 'dblclick'",
      "defaultValue": "undefined",
      "description": "字段编辑方式，字段 > FormItem > Form 继承；默认 inline。",
      "kind": "enum",
      "options": [
        "inline",
        "click",
        "dblclick"
      ],
      "initial": "inline"
    },
    {
      "name": "read-pretty",
      "type": "boolean",
      "defaultValue": "undefined",
      "description": "纯阅读展示；字段 > FormItem > Form 继承，显式 false 覆盖父级。",
      "kind": "boolean"
    },
    {
      "name": "scroll-to-error-offset-y",
