{
  "fields": [
    {
      "name": "heading",
      "description": "标题级别，相当于 h1 h2 h3 h4 h5 h6",
      "type": "1 | 2 | 3 | 4 | 5 | 6",
      "defaultValue": "1",
      "kind": "enum",
      "options": [
        "1",
        "2",
        "3",
        "4",
        "5",
        "6"
      ],
      "initial": "1"
    },
    {
      "name": "status",
      "description": "文本语义状态",
      "type": "SemanticStatus",
      "defaultValue": "-",
      "kind": "enum",
      "options": [
        "default",
        "primary",
        "secondary",
        "tertiary",
        "info",
        "success",
        "warning",
        "danger"
      ],
      "initial": "default"
    },
    {
      "name": "bold",
      "description": "粗体",
      "type": "boolean",
      "defaultValue": "false",
      "kind": "boolean"
    },
    {
      "name": "mark",
      "description": "添加标记样式",
      "type": "boolean | { color: string }",
      "defaultValue": "false",
      "kind": "json",
      "initial": "{}"
    },
    {
      "name": "underline",
      "description": "下划线样式",
      "type": "boolean",
      "defaultValue": "false",
      "kind": "boolean"
    },
    {
      "name": "delete",
      "description": "删除线样式",
      "type": "boolean",
      "defaultValue": "false",
      "kind": "boolean"
    },
    {
      "name": "code",
      "description": "代码块样式",
      "type": "boolean",
      "defaultValue": "false",
      "kind": "boolean"
    },
    {
      "name": "disabled",
      "description": "禁用状态",
      "type": "boolean",
      "defaultValue": "false",
      "kind": "boolean"
    },
    {
      "name": "editable",
      "description": "开启可编辑功能",
      "type": "boolean",
      "defaultValue": "false",
      "kind": "boolean"
    },
    {
      "name": "editing",
      "description": "是否在编辑状态",
      "type": "boolean",
      "defaultValue": "-",
      "kind": "boolean"
    },
    {
      "name": "default-editing",
      "description": "默认的编辑状态",
      "type": "boolean",
      "defaultValue": "false",
      "kind": "boolean"
    },
    {
      "name": "edit-text",
      "description": "编辑的文字",
      "type": "string",
      "defaultValue": "-",
      "kind": "string"
    },
    {
      "name": "copyable",
      "description": "开启复制功能",
      "type": "boolean",
      "defaultValue": "false",
      "kind": "boolean"
    },
    {
      "name": "copy-text",
      "description": "复制的文字",
      "type": "string",
      "defaultValue": "-",
      "kind": "string"
    },
    {
      "name": "copy-delay",
      "description": "复制成功后，复制按钮恢复到可点击状态的延迟时间，单位是毫秒",
      "type": "number",
      "defaultValue": "3000",
      "kind": "number"
    },
    {
      "name": "ellipsis",
      "description": "自动溢出省略，具体参数配置看 [EllipsisConfig](#ellipsisconfig)",
      "type": "boolean | EllipsisConfig",
      "defaultValue": "false",
      "kind": "json",
      "initial": "{}"
    },
    {
      "name": "edit-tooltip-props",
      "description": "编辑按钮 Tooltip 配置",
      "type": "object",
      "defaultValue": "-",
      "kind": "string",
      "initial": "review-class"
    },
    {
      "name": "copy-tooltip-props",
      "description": "拷贝按钮 Tooltip 配置",
      "type": "object",
      "defaultValue": "-",
      "kind": "string",
      "initial": "review-class"
    },
    {
      "name": "EllipsisConfig.rows",
      "description": "ellipsis · 显示省略的行数",
      "type": "number",
      "defaultValue": "1",
      "kind": "number",
      "path": [
        "ellipsis",
        "rows"
      ]
    },
    {
      "name": "EllipsisConfig.expandable",
      "description": "ellipsis · 是否支持展开/折叠",
      "type": "boolean",
      "defaultValue": "false",
      "kind": "boolean",
      "path": [
        "ellipsis",
        "expandable"
      ]
    },
    {
      "name": "EllipsisConfig.ellipsis-str",
      "description": "ellipsis · 省略号",
      "type": "string",
      "defaultValue": "'...'",
      "kind": "string",
      "path": [
        "ellipsis",
        "ellipsisStr"
      ]
    },
    {
      "name": "EllipsisConfig.suffix",
      "description": "ellipsis · 后缀",
      "type": "string",
      "defaultValue": "-",
      "kind": "string",
      "path": [
        "ellipsis",
        "suffix"
      ]
    },
    {
      "name": "EllipsisConfig.show-tooltip",
      "description": "ellipsis · 配置省略时的弹出框",
      "type": "boolean | { type: 'tooltip' | 'popover'; props: Record<string, any> }",
      "defaultValue": "false",
      "kind": "json",
      "initial": "{}",
      "path": [
        "ellipsis",
        "showTooltip"
      ]
    },
    {
      "name": "EllipsisConfig.css",
      "description": "ellipsis · 是否使用 CSS 省略（此模式暂不支持展开、自定义省略号和后缀）",
      "type": "boolean",
      "defaultValue": "false",
      "kind": "boolean",
      "path": [
        "ellipsis",
        "css"
      ]
    }
  ],
  "methodNames": [],
  "events": [
    "edit-start",
    "change",
    "edit-end",
    "copy",
    "ellipsis",
    "expand"
  ],
  "slotNames": [
    "expand-node",
    "copy-icon",
    "copy-tooltip"
  ],
  "slotDefaults": {
    "expand-node": false,
    "copy-icon": false,
    "copy-tooltip": false
  },
  "scenarios": []
}
