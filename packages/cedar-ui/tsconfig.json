{
  "compilerOptions": {
    "sourceMap": true,
    "allowJs": true,
    "strictNullChecks": true,
    // A few notes:
    // - Vue 3 supports ES2016+
    // - For Vite, the actual compilation target is determined by the
    //   `build.target` option in the Vite config.
    //   So don't change the `target` field here. It has to be
    //   at least `ES2020` for dynamic `import()`s and `import.meta` to work correctly.
    // - If you are not using Vite, feel free to override the `target` field.
    "target": "ESNext",
    "outDir": "dist",
    "declaration": true,
    "emitDeclarationOnly": true,
    "downlevelIteration": true,
    "importHelpers": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "allowSyntheticDefaultImports": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "useDefineForClassFields": true,
    // Required in Vue projects
    "jsx": "preserve",
    "jsxImportSource": "vue",
    // `"noImplicitThis": true` is part of `strict`
    // Added again here in case some users decide to disable `strict`.
    // This enables stricter inference for data properties on `this`.
    "strict": true,
    "noImplicitThis": true,
    "noImplicitAny": false,
    // Required in Vite
    "isolatedModules": true,
    // Recommended
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    // See <https://github.com/vuejs/vue-cli/pull/5688>
    "skipLibCheck": true,
    // Contains the specified types
    "types": ["node", "vite/client"],
    "baseUrl": ".",
    "paths": {
      "@cedarjs/ui": ["src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.tsx", "src/**/*.vue", "vitest.config.ts", "docs/**/*.ts", "docs/**/*.d.ts", "docs/.vuepress/auto-imports.d.ts"]
}
