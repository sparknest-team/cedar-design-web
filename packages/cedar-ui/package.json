{
  "name": "@cedar/ui",
  "version": "1.2.83",
  "main": "lib/index.js",
  "module": "lib/index.js",
  "types": "lib/index.d.ts",

  "style": "dist/index.css",
  "unpkg": "dist/index.min.js",
  "jsdelivr": "dist/index.min.js",
  "files": [
    "dist",
    "es",
    "lib"
  ],
  "sideEffects": [
    "dist/*",
    "es/**/style/*",
    "lib/**/style/*",
    "*.scss"
  ],
  "scripts": {
    "generatePaths": "tsx scripts/generate/generatePaths",
    "dev": "vuepress dev docs",
    "ui:gen": "tsx scripts/generate/component.ts",
    "build:lib": "pnpm icongen && gulp --require @esbuild-kit/cjs-loader -f scripts/build/index.ts",
    "build:doc": "pnpm icongen && vuepress build docs --dest dist",
    "dtsgen": "tsx scripts dtsgen 'components/**/*.{ts,tsx,vue}'",
    "icongen": "tsx scripts icongen && pnpm dtsgen:icon",
    "dtsgen:icon": "tsx scripts dtsgen 'components/icon/**/*.{ts,tsx,vue}' -o 'components/icon/@types'",
    "watch": "vite build --watch",
    "test:watch": "vitest",
    "test": "vitest --run",
    "coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "lint-staged": "lint-staged",
    "clean-cache": "rm -rf docs/.vuepress/.cache && rm -rf docs/.vuepress/.temp && rm -rf node_modules/.vite",
    "postinstall": "patch-package",
    "copy-dist": "tsx scripts copy-dist",
    "prepublishOnly": "pnpm copy-dist",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s -r 2",
    "preview": "histoire preview"
  },
  "dependencies": {
    "@arco-design/color": "^0.4.0",
    "@arco-design/web-vue": "^2.56.3",
    "@maplejs/maple-shared": "workspace:*",
    "@maplejs/maple-touch-emulator": "workspace:*",
    "@maplejs/maple-use": "workspace:*",
    "b-validate": "^1.5.3",
    "color": "^5.0.0",
    "dayjs": "^1.10.3",
    "kotlin-playground": "^1.30.0",
    "lodash": "^4.17.21",
    "lodash-es": "^4.17.21",
    "patch-package": "^6.4.7",
    "rattail": "^1.0.23",
    "sortablejs": "^1.15.3",
    "zod": "^4.1.12"
  },
  "lint-staged": {
    "src/**/*.{js,ts,json,css,md,vue}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.4.8",
    "@changesets/cli": "^2.26.1",
    "@commitlint/cli": "^17.5.1",
    "@commitlint/config-conventional": "^17.4.4",
    "@esbuild-kit/cjs-loader": "^2.3.3",
    "@mdit-vue/shared": "^0.7.0",
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@types/fs-extra": "^9.0.13",
    "@types/gulp": "^4.0.9",
    "@types/gulp-autoprefixer": "^0.0.33",
    "@types/gulp-clean-css": "^4.3.0",
    "@types/gulp-concat": "^0.0.33",
    "@types/gulp-sass": "^5.0.0",
    "@types/lodash-es": "^4.17.6",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20.12.12",
    "@types/prompts": "^2.0.14",
    "@typescript-eslint/eslint-plugin": "^8.12.2",
    "@typescript-eslint/parser": "^8.12.2",
    "@vitejs/plugin-vue": "^5.0.4",
    "@vitejs/plugin-vue-jsx": "^3.1.0",
    "@vitest/coverage-c8": "^0.22.1",
    "@vitest/ui": "^1.6.0",
    "@cedar/ui": "workspace:*",
    "@vue/eslint-config-prettier": "^6.0.0",
    "@vue/eslint-config-typescript": "^7.0.0",
    "@vue/repl": "^4.4.2",
    "@vue/runtime-core": "^3.2.47",
    "@vue/test-utils": "^2.0.2",
    "@vuepress/bundler-vite": "2.0.0-rc.18",
    "@vuepress/plugin-prismjs": "2.0.0-rc.61",
    "@vuepress/plugin-shiki": "2.0.0-rc.63",
    "@vuepress/helper": "2.0.0-rc.63",
    "@vuepress/plugin-copy-code": "2.0.0-rc.63",
    "@vuepress/plugin-medium-zoom": "2.0.0-rc.63",
    "@vuepress/plugin-slimsearch": "2.0.0-rc.63",
    "@vuepress/theme-default": "^2.0.0-rc.26",
    "@vueuse/core": "^10.9.0",
    "commitizen": "^4.3.0",
    "components-helper": "^2.0.0",
    "conventional-changelog-cli": "^4.1.0",
    "cz-conventional-changelog": "^3.3.0",
    "esbuild": "^0.15.5",
    "eslint": "^8.37.0",
    "eslint-plugin-prettier": "^3.3.1",
    "eslint-plugin-vue": "^7.0.0",
    "execa": "^6.1.0",
    "fast-glob": "^3.2.11",
    "fs-extra": "^11.2.0",
    "globby": "^14.0.1",
    "gulp": "^4.0.2",
    "gulp-autoprefixer": "^8.0.0",
    "gulp-clean-css": "^4.3.0",
    "gulp-concat": "^2.6.1",
    "gulp-sass": "^5.1.0",
    "happy-dom": "^6.0.4",
    "husky": "^8.0.3",
    "jsdom": "^24.0.0",
    "less": "^4.4.0",
    "lint-staged": "^13.2.0",
    "loca-boot-core": "^1.73.7",
    "markdown-it": "^14.1.0",
    "ora": "^8.0.1",
    "postcss": "^8.4.21",
    "posthtml-parser": "^0.11.0",
    "posthtml-render": "^3.0.0",
    "prettier": "^3.3.3",
    "prompts": "^2.4.2",
    "rollup": "^2.78.1",
    "rollup-plugin-esbuild": "^4.9.3",
    "sandpack-vue3": "^3.1.12",
    "sass": "^1.80.3",
    "sass-embedded": "^1.79.5",
    "stylelint": "^14.16.1",
    "svgo": "^3.3.2",
    "ts-morph": "^22.0.0",
    "tsx": "^3.8.2",
    "typescript": "^4.9.5",
    "unplugin-auto-import": "^20.3.0",
    "unplugin-vue-components": "^0.22.4",
    "unplugin-vue-define-options": "^0.10.0",
    "vite": "^5.3.2",
    "vitest": "^0.22.1",
    "vue": "^3.5.12",
    "vue-router": "^4.2.5",
    "vue-tsc": "^0.40.1",
    "vuepress": "2.0.0-rc.18",
    "vuepress-plugin-md-enhance": "^2.0.0-rc.43",
    "vuepress-theme-hope": "2.0.0-rc.61"
  },
  "peerDependencies": {
    "vue": "^3.5.12"
  },
  "overrides": {
    "vue": "^3.5.12"
  },
  "packageManager": "pnpm@9.6.0"
}
