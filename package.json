{
  "name": "@cedar-design/workspace-vue",
  "version": "1.1.7",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm build:lib && pnpm build:doc",
    "build:lib": "pnpm --filter @cedar-design/shared-vue build && pnpm --filter @cedar-design/use-vue build && pnpm --filter @cedar-design/icons-vue build && pnpm --filter @cedar-design/resolver-vue build && pnpm build:presets && pnpm --filter @cedar-design/ui-vue build:lib",
    "build:doc": "pnpm --filter @cedar-design/ui-vue build:doc",
    "build:presets": "pnpm --filter @cedar-design/preset-unocss-vue build && pnpm --filter @cedar-design/preset-tailwindcss-vue build",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only --ignore-scripts",
    "dev": "pnpm --filter @cedar-design/ui-vue dev",
    "test": "pnpm --filter @cedar-design/ui-vue test",
    "test:watch": "pnpm --filter @cedar-design/ui-vue test:watch",
    "typecheck": "pnpm --filter @cedar-design/ui-vue typecheck && pnpm --dir packages/ui exec vue-tsc --noEmit -p tsconfig.p1-api.json",
    "spec:check": "node scripts/quality/spec-check.mjs",
    "package:check": "node scripts/quality/package-check.mjs && node scripts/quality/native-esm-check.mjs",
    "quality": "pnpm check:demo-i18n && pnpm check:install-patches && pnpm check:packages && pnpm check:shared && pnpm check:runtime-dependencies && pnpm check:vue-compat:source && pnpm build:lib && pnpm check:vue-compat && pnpm spec:check && pnpm check:style-vars && pnpm lint && pnpm typecheck && pnpm test && pnpm check:direction && pnpm check:cli && pnpm check:resolver && pnpm check:doc-pipeline && pnpm build:doc && pnpm package:check && pnpm check:published-environment && pnpm check:docs-theme && pnpm check:docs-components && pnpm check:compatibility",
    "check:doc-pipeline": "node --test ../design-ui/bin/public-documentation-policy.test.mjs ../design-ui/bin/component-css-docs.test.mjs && node ../design-ui/bin/public-docs-check.mjs && node --test ../design-ui/bin/clean-public-component-docs.test.mjs ../design-ui/bin/normalize-api-headings.test.mjs ../design-ui/bin/api-document-structure.test.mjs ../design-ui/bin/llms-docs.test.mjs ../design-ui/bin/group-demo-sections.test.mjs ../design-ui/bin/group-maple-examples.test.mjs ../design-ui/bin/compose-demo-comparison.test.mjs ../design-ui/bin/demo-config-comparison.test.mjs ../design-ui/bin/demo-content-parity.test.mjs ../design-ui/bin/api-documentation-locales.test.mjs && pnpm --dir packages/ui exec vitest run --config docs/.vuepress/vitest.config.mts --maxWorkers=1 --no-file-parallelism",
    "check:docs-theme": "node --test scripts/browser/docs-theme.test.mjs",
    "check:docs-components": "node --test scripts/browser/components.test.mjs",
    "check:published-environment": "node ../design-ui/bin/published-environment-check.mjs",
    "check:test-environment": "node --test scripts/quality/test-environment.test.mjs packages/ui/scripts/testing/source-dependencies.test.mjs",
    "check:cli": "pnpm --filter @cedar-design/cli-vue test",
    "check:resolver": "pnpm --filter @cedar-design/resolver-vue test",
    "check:shared": "node --test scripts/quality/shared-bundle.test.mjs",
    "check:runtime-dependencies": "node scripts/quality/runtime-dependency-check.mjs && pnpm --dir packages/ui exec vitest run --config site-imports.vitest.config.mts --maxWorkers=1 --no-file-parallelism",
    "format": "pnpm --filter @cedar-design/ui-vue format",
    "lint": "pnpm --filter @cedar-design/ui-vue lint",
    "icons:build": "pnpm --filter @cedar-design/icons-vue build",
    "icons:check": "pnpm --filter @cedar-design/icons-vue generate:check",
    "ui:gen": "pnpm --filter @cedar-design/ui-vue ui:gen",
    "dtsgen": "pnpm --filter @cedar-design/ui-vue dtsgen",
    "watch": "pnpm --filter @cedar-design/ui-vue watch",
    "clean-cache": "pnpm --filter @cedar-design/ui-vue clean-cache",
    "preview": "pnpm --filter @cedar-design/ui-vue preview",
    "release": "node scripts/release.mjs",
    "prepare": "node scripts/git-hooks.mjs install",
    "check:tabs": "node checks/tabs-same-source.mjs",
    "check:rate": "node checks/rate-same-source.mjs",
    "check:ripple": "node checks/ripple-same-source.mjs",
    "check:lightweight-feedback": "node checks/lightweight-feedback-same-source.mjs",
    "check:input": "node checks/input-same-source.mjs",
    "check:selection-field": "node --test ../design-ui/bin/selection-field-class-normalization.test.mjs && node checks/selection-field-same-source.mjs",
    "check:selection-presentations": "node --test checks/selection-normalization.test.mjs && node checks/selection-presentations-same-source.mjs",
    "check:auto-complete": "node checks/auto-complete-same-source.mjs",
    "check:time-rules": "node checks/time-rules-same-source.mjs",
    "check:form-kernel": "node checks/form-kernel-same-source.mjs",
    "check:style-vars": "node checks/style-vars-contract.mjs && node --test ../design-ui/bin/css-variable-consumers.test.mjs && node ../design-ui/bin/component-css-docs.mjs --check",
    "check:date-family": "node checks/date-family-same-source.mjs",
    "check:scroll-text": "node checks/scroll-text-same-source.mjs",
    "check:api-naming": "node ../design-ui/bin/api-naming-check.mjs",
    "check:compatibility": "node ../design-ui/browser/matrix.mjs cedar",
    "compatibility:native:init": "node ../design-ui/browser/native-acceptance.mjs cedar --init",
    "check:compatibility:release": "node ../design-ui/browser/native-acceptance.mjs cedar",
    "check:direction": "pnpm --dir packages/ui exec vitest run src/_utils/__tests__/reading-direction.spec.js src/table/__tests__/reading-direction.spec.ts src/steps/__tests__/reading-direction.spec.js src/timeline/__tests__/reading-direction.spec.js src/nav-menu/__tests__/reading-direction.spec.js src/tree/__tests__/reading-direction.spec.js src/transfer/__tests__/reading-direction.spec.js src/split/__tests__/reading-direction.spec.js src/resize-box/__tests__/reading-direction.spec.js src/_components/virtual-list-v2/__tests__/reading-direction.spec.js src/table/__tests__/sticky-scrollbar.spec.ts --maxWorkers=1 --no-file-parallelism src/scheduler/__tests__/reading-direction.test.tsx src/field-decorator/__tests__/reading-direction.spec.js src/form/__tests__/reading-direction.spec.ts src/radio/__tests__/reading-direction.spec.js src/cascader/__tests__/reading-direction.spec.ts src/tree-select/__tests__/reading-direction.spec.ts src/auto-complete/__tests__/reading-direction.spec.ts src/date/__tests__/reading-direction.spec.ts src/time/__tests__/reading-direction.spec.ts src/time-range/__tests__/reading-direction.spec.ts src/button/__tests__/reading-direction.spec.ts src/split-button/__tests__/reading-direction.spec.ts src/space/__tests__/reading-direction.spec.ts src/divider/__tests__/reading-direction.spec.ts",
    "check:packages": "node --test scripts/quality/package-boundary-check.test.mjs && node scripts/quality/package-boundary-check.mjs",
    "check:vue-compat:source": "node ../design-ui/bin/vue-compat-check.mjs --source",
    "check:vue-compat": "node --test ../design-ui/bin/vue-compat-check.test.mjs && node ../design-ui/bin/vue-compat-check.mjs",
    "check:demo-i18n": "node --test scripts/quality/demo-i18n-ci.test.mjs && pnpm check:test-environment && node --test ../design-ui/bin/compose-demo-comparison.test.mjs ../design-ui/bin/demo-config-comparison.test.mjs && pnpm --dir packages/ui exec vitest run src/__demos__/locale --maxWorkers=1 --no-file-parallelism",
    "hooks:install": "node scripts/git-hooks.mjs install",
    "pr:merge": "node scripts/pr-merge.mjs",
    "check:pr-workflow": "node --test ../design-ui/bin/pr-workflow.test.mjs",
    "check:install-patches": "node --test scripts/quality/source-map-patch.test.mjs"
  },
  "packageManager": "pnpm@9.6.0",
  "devDependencies": {
    "@cedar-design/cli-vue": "workspace:*",
    "@sparknest/theme-contract-vue": "link:../design-ui/packages/theme-contract",
    "@changesets/changelog-github": "^0.5.1",
    "@changesets/cli": "^2.29.7",
    "nanospinner": "^1.2.2",
    "playwright": "1.62.0",
    "tinyexec": "npm:tinyexec@^0.3.0",
    "vue-compat-min": "npm:vue@3.2.47",
    "vue": "catalog:",
    "@vue/compiler-sfc": "catalog:",
    "@vue/server-renderer": "catalog:",
    "yaml": "2.9.0",
    "picomatch": "4.0.4"
  },
  "engines": {
    "pnpm": ">=9.6.0",
    "node": ">=26.13.1"
  },
  "pnpm": {
    "overrides": {
      "@sparknest/ui-build-vue": "link:../design-ui/packages/ui-build",
      "@sparknest/ui-doc-preview-vue": "link:../design-ui/packages/ui-doc-preview",
      "@sparknest/ui-icons-vue": "link:../design-ui/packages/ui-icons",
      "@sparknest/theme-contract-vue": "link:../design-ui/packages/theme-contract"
    },
    "patchedDependencies": {
      "@vuepress/plugin-slimsearch@2.0.0-rc.63": "patches/@vuepress__plugin-slimsearch@2.0.0-rc.63.patch",
      "source-map-js@1.2.2": "patches/source-map-js@1.2.2.patch"
    }
  },
  "volta": {
    "node": "26.13.1",
    "pnpm": "9.6.0"
  }
}
