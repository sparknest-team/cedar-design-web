{
  "name": "cedar-design-web-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm build:lib && pnpm build:doc",
    "build:lib": "pnpm --filter @cedarjs/shared build && pnpm --filter @cedarjs/use build && pnpm --filter @cedarjs/icons-vue build && pnpm --filter @cedarjs/resolver build && pnpm --filter @cedarjs/ui build:lib",
    "build:doc": "pnpm --filter @cedarjs/ui build:doc",
    "build:presets": "pnpm --filter @cedarjs/preset-unocss build && pnpm --filter @cedarjs/preset-tailwindcss build",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "dev": "pnpm --filter @cedarjs/ui dev",
    "test": "pnpm --filter @cedarjs/ui test",
    "test:watch": "pnpm --filter @cedarjs/ui test:watch",
    "typecheck": "pnpm --filter @cedarjs/ui typecheck",
    "spec:check": "node scripts/quality/spec-check.mjs",
    "package:check": "node scripts/quality/package-check.mjs",
    "quality": "pnpm spec:check && pnpm check:style-vars && pnpm typecheck && pnpm test && pnpm build && pnpm package:check",
    "format": "pnpm --filter @cedarjs/ui format",
    "lint": "pnpm --filter @cedarjs/ui lint",
    "icons:build": "pnpm --filter @cedarjs/icons-vue build",
    "icons:check": "pnpm --filter @cedarjs/icons-vue generate:check",
    "ui:gen": "pnpm --filter @cedarjs/ui ui:gen",
    "dtsgen": "pnpm --filter @cedarjs/ui dtsgen",
    "watch": "pnpm --filter @cedarjs/ui watch",
    "clean-cache": "pnpm --filter @cedarjs/ui clean-cache",
    "preview": "pnpm --filter @cedarjs/ui preview",
    "release": "node scripts/release.mjs",
    "prepare": "husky install packages/cedar-ui/.husky",
    "postinstall": "patch-package --patch-dir packages/cedar-ui/patches",
    "check:tabs": "node checks/tabs-same-source.mjs",
    "check:rate": "node checks/rate-same-source.mjs",
    "check:ripple": "node checks/ripple-same-source.mjs",
    "check:lightweight-feedback": "node checks/lightweight-feedback-same-source.mjs",
    "check:style-vars": "node checks/style-vars-contract.mjs"
  },
  "packageManager": "pnpm@9.6.0",
  "devDependencies": {
    "@cedarjs/cli": "workspace:*",
    "@ui-foundation/theme-contract": "link:../design-ui/packages/theme-contract",
    "@changesets/changelog-github": "^0.5.1",
    "@changesets/cli": "^2.29.7",
    "nanospinner": "^1.2.2",
    "tinyexec": "npm:tinyexec@^0.3.0"
  },
  "engines": {
    "pnpm": ">=9.6.0"
  }
}
